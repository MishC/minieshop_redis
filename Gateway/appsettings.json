{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Redis": "localhost:6379"
  },
  "Jwt": {
    "Key": "dev-only-shop-microservices-jwt-signing-key-change-me-please-32chars",
    "Issuer": "ShopMicroservices",
    "Audience": "ShopMicroservices.Client",
    "AccessTokenMinutes": 60
  },
  "AuthCookie": {
    "Name": "access_token",
    "Secure": false,
    "SameSite": "Lax"
  },
  "Auth": {
    "AdminEmails": [
      "admin@test.com"
    ]
  },
  "ReverseProxy": {
    "Routes": {
      "products-admin-route": {
        "ClusterId": "products-cluster",
        "AuthorizationPolicy": "admin",
        "Match": {
          "Path": "/products"
        },
        "Transforms": [
          { "PathSet": "/api/products" }
        ]
      },
      "recent-views-route": {
        "ClusterId": "products-cluster",
        "AuthorizationPolicy": "authenticated",
        "Match": {
          "Path": "/RecentViews"
        },
        "Transforms": [
          { "PathSet": "/api/products/RecentViews" }
        ]
      },
      "products-recent-views-route": {
        "ClusterId": "products-cluster",
        "AuthorizationPolicy": "authenticated",
        "Match": {
          "Path": "/products/RecentViews"
        },
        "Transforms": [
          { "PathSet": "/api/products/RecentViews" }
        ]
      },
      "products-route": {
        "ClusterId": "products-cluster",
        "Match": {
          "Path": "/products/{id:int}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/products" },
          { "PathPrefix": "/api/products" }
        ]
      },
      "cart-route": {
        "ClusterId": "cart-cluster",
        "AuthorizationPolicy": "authenticated",
        "Match": {
          "Path": "/cart/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/cart" },
          { "PathPrefix": "/api/cart" }
        ]
      },
      "orders-route": {
        "ClusterId": "orders-cluster",
        "AuthorizationPolicy": "authenticated",
        "Match": {
          "Path": "/orders/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/orders" },
          { "PathPrefix": "/api/orders" }
        ]
      }
    },
    "Clusters": {
      "products-cluster": {
        "Destinations": {
          "d1": {
            "Address": "http://catalogservice:8080/"
          }
        }
      },
      "cart-cluster": {
        "Destinations": {
          "d1": {
            "Address": "http://cartservice:8080/"
          }
        }
      },
      "orders-cluster": {
        "Destinations": {
          "d1": {
            "Address": "http://orderservice:8080/"
          }
        }
      }
    }
  }
}
