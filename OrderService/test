using System.Net.Http.Json;
using System.Text.Json;
using OrderService.Models;
using OrderService.Data;

app.MapPost("/orders", async (
    CreateOrderRequest request,
    IHttpClientFactory httpClientFactory,
    OrderDbContext db) =>
{
    var cartClient = httpClientFactory.CreateClient("cart");
    var catalogClient = httpClientFactory.CreateClient("catalog");

    // 🔹 1. get cart from CartService
    var cartResponse = await cartClient.GetAsync($"/cart/{request.UserId}");

    if (!cartResponse.IsSuccessStatusCode)
        return Results.BadRequest("Failed to fetch cart");

    var cart = await cartResponse.Content.ReadFromJsonAsync<CartResponse>();

    if (cart is null || !cart.Items.Any())
        return Results.BadRequest("Cart is empty");

    var order = new Order
    {
        UserId = request.UserId,
        Email = request.Email,
        Address = request.Address,
        City = request.City,
        PostalCode = request.PostalCode,
        Country = request.Country,
        CreatedAtUtc = DateTime.UtcNow
    };

    // 🔥 2. enrich items via CatalogService
    foreach (var item in cart.Items)
    {
        var productResponse = await catalogClient.GetAsync($"/products/{item.ProductId}");

        if (!productResponse.IsSuccessStatusCode)
            return Results.BadRequest($"Product {item.ProductId} not found");

        var product = await productResponse.Content.ReadFromJsonAsync<ProductResponse>();

        if (product is null)
            return Results.BadRequest("Invalid product data");

        order.Items.Add(new OrderItem
        {
            ProductId = product.Id,
            ProductName = product.Name,
            UnitPrice = product.Price,
            Quantity = item.Quantity
        });
    }

    // 🔥 3. total
    order.TotalAmount = order.Items.Sum(i => i.UnitPrice * i.Quantity);

    // 🔥 4. save to PostgreSQL
    db.Orders.Add(order);
    await db.SaveChangesAsync();

    // 🔥 5. clear cart
    await cartClient.DeleteAsync($"/cart/{request.UserId}");

    return Results.Ok(order);
});